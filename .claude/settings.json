{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git tag *)"
    ],
    "deny": [
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-selftest.js\"",
            "timeout": 30,
            "statusMessage": "Running selftest"
          }
        ]
      }
    ]
  }
}
